msgid "Lion"
msgstr "Lion"

#: addon\globalPlugins\lion\__init__.py:91
msgid "Toggle OCR"
msgstr "开关 OCR"

#: addon\globalPlugins\lion\__init__.py:94
msgid "Please disable screen curtain before using OCR."
msgstr "请在使用 OCR 之前关闭黑屏。"

#: addon\globalPlugins\lion\__init__.py:101
msgid "Lion started"
msgstr "启动Lion"

#: addon\globalPlugins\lion\__init__.py:111
msgid "Lion stopped"
msgstr "停止Lion"

#: addon\globalPlugins\lion\__init__.py:156
msgid "Lion stopped because the screen curtain was enabled."
msgstr "你打开了黑屏模式，Lion 已停止"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: addon\globalPlugins\lion\lionGui.py:18 buildVars.py:21
msgid "LION"
msgstr "LION"

#: addon\globalPlugins\lion\lionGui.py:19
msgid "Modify OCR area, interval, and text similarity threshold"
msgstr "修改 OCR 区域、识别间隔和文本相似度阈值"

#. Translators: label for the OCR interval slider
#: addon\globalPlugins\lion\lionGui.py:29
msgid "OCR &interval (seconds):"
msgstr "识别间隔(&I):"

#. Translators: label for the OCR target choice
#: addon\globalPlugins\lion\lionGui.py:42
msgid "&OCR target:"
msgstr "识别目标(&O):"

#: addon\globalPlugins\lion\lionGui.py:45
msgid "Navigator object"
msgstr "导航对象"

#: addon\globalPlugins\lion\lionGui.py:46
msgid "Whole screen"
msgstr "全屏幕"

#: addon\globalPlugins\lion\lionGui.py:47
msgid "Current window"
msgstr "当前窗口"

#: addon\globalPlugins\lion\lionGui.py:48
msgid "Current control"
msgstr "当前控件"

#. Translators: label for the text similarity threshold slider
#: addon\globalPlugins\lion\lionGui.py:58
msgid "&Text similarity threshold (%):"
msgstr "文本相似度阈值(&T):"

#: addon\globalPlugins\lion\lionGui.py:71
msgid "Crop pixels from &above (%):"
msgstr "从上方裁剪像素(%):"

#: addon\globalPlugins\lion\lionGui.py:76
msgid "Crop pixels from &below (%):"
msgstr "从下方裁剪像素(%):"

#: addon\globalPlugins\lion\lionGui.py:81
msgid "Crop pixels from &left (%):"
msgstr "从左侧裁剪像素(%):"

#: addon\globalPlugins\lion\lionGui.py:86
msgid "Crop pixels from &right (%):"
msgstr "从右侧裁剪像素(%):"

#. Translators: label for the multiline regular expression filter field
#: addon\globalPlugins\lion\lionGui.py:92
msgid "Regular expression filters (one per &line):"
msgstr "正则表达式过滤器（每行一条）："

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid ""
"does live OCR for the whole screen, refreshing at a specified interval.\n"
"\tToggle with NVDA+alt+n."
msgstr "对屏幕内容以指定的时间间隔进行实时 OCR。使用 NVDA+Alt+N 开关。"

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:30
msgid ""
"Added regular expression filters for recognized text.\n"
"\tOne expression per line.\n"
"\tCompatible with NVDA 2026.1."
msgstr ""
"新增了识别结果正则表达式过滤功能。\n"
"\t每个表达式一行。\n"
"\t兼容 NVDA 2026.1。"
